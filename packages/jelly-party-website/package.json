    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "unocss": "66.12.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
